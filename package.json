{
  "name": "openchesslab",
  "version": "0.6.1",
  "description": "A local-first chess analysis and UCI engine experimentation workspace.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch src/server/index.ts\" \"vite\"",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.server.json && vite build && node scripts/postbuild-client.mjs && node scripts/licenses.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "docs:check": "node scripts/check-docs.mjs",
    "smoke:http": "node scripts/smoke-http.mjs",
    "capture:ui": "node scripts/capture-ui.mjs",
    "icons:make": "node scripts/make-launcher-icons.mjs",
    "check": "npm run lint && npm run typecheck && npm run docs:check && npm test",
    "security": "npm audit --audit-level=high",
    "release:pack": "npm run build && node scripts/package-release.mjs",
    "bundle:verify": "node scripts/verify-bundle.mjs",
    "regress": "node scripts/regress.mjs",
    "icons:windows": "node scripts/make-windows-icon.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "chess.js": "^1.4.0",
    "fastify": "^5.12.8",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stockfish": "19.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@capacitor/cli": "8.6.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "concurrently": "^10.0.7",
    "esbuild": "0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "postject": "1.0.0-alpha.6",
    "prettier": "^3.10.1",
    "rcedit": "5.0.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
